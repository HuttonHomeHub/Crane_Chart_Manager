{
  "extends": "./vendor/hhh-platform/packages/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // Vite bundles this code, so resolve modules the way a bundler does.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client"]
  },
  "include": ["shared/**/*.ts", "src/**/*.ts", "src/**/*.tsx", "tests/**/*.tsx"],
  "exclude": ["node_modules", "dist", "vendor"]
}
