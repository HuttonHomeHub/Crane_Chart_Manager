{
  "name": "crane-charts",
  "private": true,
  "description": "Crane Charts: the TypeScript rebuild on hhh-platform (phase 4). The release version stays in VERSION.",
  "type": "module",
  "scripts": {
    "server": "node server/index.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json",
    "vendor:check": "node vendor/hhh-platform/scripts/vendor.ts --check",
    "check": "npm run vendor:check && npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm audit --audit-level=high"
  },
  "dependencies": {
    "@hhh/server": "file:vendor/hhh-platform/packages/server",
    "better-sqlite3": "^13.1.1",
    "compression": "^1.8.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@hhh/config": "file:vendor/hhh-platform/packages/config",
    "@types/better-sqlite3": "9.6.0",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
